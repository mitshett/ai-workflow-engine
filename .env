# AI Workflow Engine - Local Development Environment
# This file contains the actual environment variables for local development

# =====================================================================================
# DATABASE CONFIGURATION
# =====================================================================================

# PostgreSQL Database Settings
POSTGRES_DB=ai_workflow_engine
POSTGRES_USER=postgres
POSTGRES_PASSWORD=workflow_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Full Database URL (used by the application)
DATABASE_URL=postgresql+asyncpg://postgres:workflow_password@localhost:5433/ai_workflow_engine

# =====================================================================================
# PGADMIN CONFIGURATION
# =====================================================================================

# pgAdmin Web Interface Settings
PGADMIN_EMAIL=admin@workflow.local
PGADMIN_PASSWORD=admin_password
PGADMIN_PORT=8080

# =====================================================================================
# REDIS CONFIGURATION
# =====================================================================================

# Redis Cache Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# =====================================================================================
# APPLICATION CONFIGURATION
# =====================================================================================

# Workflow Engine Settings
WORKFLOW_ENGINE_HOST=0.0.0.0
WORKFLOW_ENGINE_PORT=8000
LOG_LEVEL=INFO

# Development Mode
DEBUG=true
RELOAD=true

# =====================================================================================
# PERFORMANCE CONFIGURATION
# =====================================================================================

# Database Connection Pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Workflow Execution
MAX_PARALLEL_NODES=5
DEFAULT_NODE_TIMEOUT=300
SNAPSHOT_INTERVAL=100

