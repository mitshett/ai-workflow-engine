# AI Workflow Engine - Environment Configuration
# Copy this file to .env and customize the values

# =====================================================================================
# DATABASE CONFIGURATION
# =====================================================================================

# PostgreSQL Database Settings
POSTGRES_DB=ai_workflow_engine
POSTGRES_USER=postgres
POSTGRES_PASSWORD=workflow_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full Database URL (used by the application)
DATABASE_URL=postgresql+asyncpg://postgres:workflow_password@localhost:5432/ai_workflow_engine

# =====================================================================================
# PGADMIN CONFIGURATION (Optional - for database management UI)
# =====================================================================================

# pgAdmin Web Interface Settings
PGADMIN_EMAIL=admin@workflow.local
PGADMIN_PASSWORD=admin_password
PGADMIN_PORT=8080

# =====================================================================================
# REDIS CONFIGURATION (Optional - for future caching/queuing)
# =====================================================================================

# Redis Cache Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# =====================================================================================
# APPLICATION CONFIGURATION
# =====================================================================================

# Workflow Engine Settings
WORKFLOW_ENGINE_HOST=0.0.0.0
WORKFLOW_ENGINE_PORT=8000
LOG_LEVEL=INFO

# AI Provider API Keys (set these for production use)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# MCP Server Configuration
MCP_SERVER_TIMEOUT=30
MCP_CONNECTION_POOL_SIZE=5

# =====================================================================================
# SECURITY CONFIGURATION
# =====================================================================================

# JWT Secret for API authentication (generate a secure key for production)
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true

# =====================================================================================
# PERFORMANCE CONFIGURATION
# =====================================================================================

# Database Connection Pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Workflow Execution
MAX_PARALLEL_NODES=10
DEFAULT_NODE_TIMEOUT=300
SNAPSHOT_INTERVAL=100

# =====================================================================================
# DEVELOPMENT CONFIGURATION
# =====================================================================================

# Development Mode
DEBUG=false
RELOAD=false

# Testing
TEST_DATABASE_URL=postgresql+asyncpg://postgres:workflow_password@localhost:5432/ai_workflow_engine_test